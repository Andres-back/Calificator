# Build-only toolchain; never part of the application/runtime image.
FROM emscripten/emsdk:3.1.74@sha256:af45409f3199d88db4b1b03af0098532c8fb33a375ac257463eeb0a622870d06 AS build
ARG OPENCV_COMMIT=fe38fc608f6acb8b68953438a62305d8318f4fcd
RUN git clone --depth 1 --branch 4.13.0 https://github.com/opencv/opencv.git /src/opencv \
    && test "$(git -C /src/opencv rev-parse HEAD)" = "$OPENCV_COMMIT"
WORKDIR /src/opencv
RUN emcmake python3 platforms/js/build_js.py /build/opencv \
    --build_wasm --disable_single_file \
    --build_flags="-s DYNAMIC_EXECUTION=0 -s ALLOW_MEMORY_GROWTH=1 -s MAXIMUM_MEMORY=536870912 -s ENVIRONMENT=web,worker,node -Oz" \
    --cmake_option="-DBUILD_LIST=core,imgproc,js" \
    --cmake_option="-DBUILD_TESTS=OFF" \
    --cmake_option="-DBUILD_PERF_TESTS=OFF" \
    --cmake_option="-DBUILD_EXAMPLES=OFF"
RUN mkdir /artifact \
    && cp /build/opencv/bin/opencv.js /build/opencv/bin/opencv_js.wasm /artifact/ \
    && cp LICENSE /artifact/LICENSE-OpenCV.txt \
    && cd /artifact && sha256sum opencv.js opencv_js.wasm > SHA256SUMS

FROM scratch AS artifact
COPY --from=build /artifact/ /
