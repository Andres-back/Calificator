{
  "name": "xcalificator-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "lint:strict": "eslint src --ext .ts,.tsx --max-warnings=0",
    "check": "npm run audit:actions && npm run lint && npx tsc --noEmit && npm run test:run && npm run build",
    "audit:actions": "node scripts/audit-actions.mjs",
    "build:analyze": "vite-bundle-analyzer -m static -f report.html --open false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:mock": "playwright test --config=e2e/mock",
    "test:visual": "playwright test --config=e2e/visual",
    "test:a11y": "playwright test --config=e2e/accessibility"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "gsap": "^3.15.0",
    "katex": "^0.17.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.13.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
