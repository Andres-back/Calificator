# Vite development is localhost-only by default.
# Set this only when you intentionally need to test from another device on your LAN.
# VITE_ALLOW_LAN=true

# Presenton routes can attach an internal Basic Auth header through the dev proxy.
# If LAN access is enabled, keep these routes disabled unless this second opt-in is required.
# VITE_ALLOW_PRESENTON_PROXY_ON_LAN=true