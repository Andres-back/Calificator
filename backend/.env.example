ENV=development
APP_NAME=XCalificator
API_PREFIX=/api
SECRET_KEY=change-me
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

POSTGRES_DB=xcalificator
POSTGRES_USER=xcalificator
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://xcalificator:change-me@postgres:5432/xcalificator
REDIS_URL=redis://redis:6379/0

UPLOADS_DIR=/app/uploads
PUBLIC_UPLOADS_BASE_URL=/uploads
MAX_IMAGE_SIZE_MB=10
MAX_GRADING_PDF_PAGES=20
GRADING_PDF_RENDER_DPI=150
OPEN_CODE_DIGITALIZATION_VISION_MODEL=mimo-v2.5
OPEN_CODE_DIGITALIZATION_VISION_TIMEOUT_SECONDS=60
OPEN_CODE_DIGITALIZATION_MODEL=mimo-v2.5
OPEN_CODE_DIGITALIZATION_TIMEOUT_SECONDS=180
OPEN_CODE_DIGITALIZATION_MAX_TOKENS=3072
PHOTO_GRADING_VISION_MODEL=qwen3.7-plus
PHOTO_GRADING_VISION_FALLBACK_MODEL=qwen3.6-plus
PHOTO_GRADING_VISION_LAST_RESORT_MODEL=mimo-v2.5
PHOTO_GRADING_TEXT_MODEL=deepseek-v4-flash
PHOTO_GRADING_TEXT_REVIEW_MODEL=deepseek-v4-pro
PHOTO_GRADING_COMPARATOR_MODEL=deepseek-v4-flash
PHOTO_GRADING_CROSS_PROVIDER_FALLBACK_ENABLED=false
