ENV=development
APP_NAME=XCalificator
API_PREFIX=/api
SECRET_KEY=change-me
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

POSTGRES_DB=xcalificator
POSTGRES_USER=xcalificator
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://xcalificator:change-me@postgres:5432/xcalificator
REDIS_URL=redis://redis:6379/0

UPLOADS_DIR=/app/uploads
PUBLIC_UPLOADS_BASE_URL=/uploads
MAX_IMAGE_SIZE_MB=10
MAX_GRADING_PDF_PAGES=20
GRADING_PDF_RENDER_DPI=150
# El grading textual puede esperar; visión siempre tiene read-timeout explícito.
AI_PROVIDER_CONNECT_TIMEOUT_SECONDS=15
AI_PROVIDER_WRITE_TIMEOUT_SECONDS=60
AI_PROVIDER_POOL_TIMEOUT_SECONDS=30
VISION_PROVIDER=opencode
VISION_MODEL=deepseek-v4-flash-vision-exp
VISION_TIMEOUT_SECONDS=90
VISION_TOTAL_TIMEOUT_SECONDS=240
VISION_MAX_RETRIES=1
VISION_FALLBACK_ENABLED=true
VISION_FALLBACK_MODELS=qwen3.7-plus,mimo-v2.5
VISION_MAX_CONCURRENCY=3
VISION_MAX_IMAGE_SIDE=2200
VISION_MAX_TOKENS=3072
DIGITALIZATION_SLOW_WARNING_SECONDS=90
PHOTO_GRADING_SLOW_WARNING_SECONDS=90
OPEN_CODE_DIGITALIZATION_VISION_MODEL=deepseek-v4-flash-vision-exp
OPEN_CODE_DIGITALIZATION_VISION_TIMEOUT_SECONDS=60
OPEN_CODE_DIGITALIZATION_MODEL=deepseek-v4-flash
OPEN_CODE_DIGITALIZATION_TIMEOUT_SECONDS=60
OPEN_CODE_DIGITALIZATION_MAX_TOKENS=3072
# Legacy: compatibilidad; no cancela el job.
DIGITALIZATION_TOTAL_TIMEOUT_SECONDS=180
PHOTO_GRADING_VISION_MODEL=deepseek-v4-flash-vision-exp
PHOTO_GRADING_VISION_FALLBACK_MODEL=qwen3.6-plus
PHOTO_GRADING_VISION_LAST_RESORT_MODEL=mimo-v2.5
PHOTO_GRADING_TEXT_MODEL=deepseek-v4-flash
PHOTO_GRADING_VERIFIER_MODEL=deepseek-v4-flash
# deepseek-v4-pro se reserva para arbitraje excepcional.
PHOTO_GRADING_TEXT_REVIEW_MODEL=deepseek-v4-pro
PHOTO_GRADING_COMPARATOR_MODEL=deepseek-v4-pro
PHOTO_GRADING_CROSS_PROVIDER_FALLBACK_ENABLED=false
# Legacy: umbrales observacionales; no cortan la lectura.
PHOTO_GRADING_VISION_TIMEOUT_SECONDS=75
PHOTO_GRADING_GRADERS_TIMEOUT_SECONDS=45
PHOTO_GRADING_VERIFIER_TIMEOUT_SECONDS=20
PHOTO_GRADING_ARBITER_TIMEOUT_SECONDS=30
PHOTO_GRADING_PRIMARY_MAX_TOKENS=3072
PHOTO_GRADING_VERIFIER_MAX_TOKENS=1536
PHOTO_GRADING_ARBITRATION_MIN_CONFIDENCE=0.75
PHOTO_GRADING_ARBITRATION_SCORE_DELTA=0.5
PHOTO_GRADING_MODEL_MAX_ATTEMPTS=1
# Legacy: compatibilidad; no cancela el pipeline.
PHOTO_GRADING_TOTAL_TIMEOUT_SECONDS=180
EXPLAINABLE_GRADING_GENERATION_ENABLED=true
EXPLAINABLE_GRADING_AUTHORITY_ENABLED=false
