ENV=development
APP_NAME=XCalificator
API_PREFIX=/api
SECRET_KEY=change-me
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

POSTGRES_DB=xcalificator
POSTGRES_USER=xcalificator
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://xcalificator:change-me@postgres:5432/xcalificator
REDIS_URL=redis://redis:6379/0

UPLOADS_DIR=/app/uploads
PUBLIC_UPLOADS_BASE_URL=/uploads
MAX_IMAGE_SIZE_MB=10
MAX_GRADING_PDF_PAGES=20
GRADING_PDF_RENDER_DPI=150
PHOTO_GRADING_FAST_VISION_ENABLED=true
PHOTO_GRADING_FAST_GRADERS_ENABLED=true

PRESENTON_INTERNAL_URL=http://presenton:80
PRESENTON_BASE_URL=http://presenton:80
PRESENTON_DATABASE_URL=sqlite:////app_data/presenton.db
PRESENTON_USER_CONFIG_PATH=/app_data/userConfig.json
PRESENTON_PUBLIC_EDITOR_URL=/presenton
PRESENTON_AUTH_USERNAME=presenton_admin
PRESENTON_AUTH_PASSWORD=change-me-presenton
PRESENTON_AUTH_OVERRIDE_FROM_ENV=true
PRESENTON_RESET_AUTH=false
PRESENTON_LLM=custom
PRESENTON_CUSTOM_LLM_URL=
PRESENTON_CUSTOM_LLM_API_KEY=
PRESENTON_CUSTOM_MODEL=
PRESENTON_DISABLE_IMAGES=false
PRESENTON_PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PRESENTON_BASIC_AUTH=
