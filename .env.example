# Copy to .env on the VPS. Never commit the resulting .env file.
ENV=production
APP_NAME=XCalificator
API_PREFIX=/api
ENABLE_API_DOCS=false
# Match the Linux account that owns ./uploads on the VPS (`id -u`, `id -g`).
APP_UID=1000
APP_GID=1000

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Public hostnames, comma separated and without scheme.
TRUSTED_HOSTS=xcalificator.example.com,localhost,127.0.0.1,testserver
# Keep same-origin deployments explicit; comma separate additional origins.
CORS_ORIGINS=https://xcalificator.example.com

POSTGRES_DB=xcalificator_db
POSTGRES_USER=xcalificator
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+asyncpg://xcalificator:replace-with-url-encoded-database-password@postgres:5432/xcalificator_db

REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:replace-with-url-encoded-redis-password@redis:6379/0

UPLOADS_DIR=/app/uploads
PUBLIC_UPLOADS_BASE_URL=/uploads
MAX_IMAGE_SIZE_MB=10

# Providers can also be configured from the admin UI after first login.
OPEN_CODE_API_KEY=
OPEN_CODE_BASE_URL=https://opencode.ai/zen/go/v1
OPEN_CODE_MODEL=deepseek-v4-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
OLLAMA_ENDPOINT=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

PRESENTON_INTERNAL_URL=http://presenton:80
PRESENTON_BASE_URL=http://presenton:80
PRESENTON_DATABASE_URL=sqlite:////app_data/presenton.db
PRESENTON_USER_CONFIG_PATH=/app_data/userConfig.json
PRESENTON_PUBLIC_EDITOR_URL=/presenton
PRESENTON_TEMPLATE=modern
PRESENTON_AUTH_USERNAME=presenton_admin
PRESENTON_AUTH_PASSWORD=replace-with-a-long-random-presenton-password
PRESENTON_AUTH_OVERRIDE_FROM_ENV=true
PRESENTON_RESET_AUTH=false
PRESENTON_PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Optional. The web container computes it from username/password when empty.
PRESENTON_BASIC_AUTH=

SERVER_NAME=xcalificator.example.com
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
PRESENTON_PORT=5001
OLLAMA_PORT=11434
BACKEND_WORKERS=2
CELERY_CONCURRENCY=2
