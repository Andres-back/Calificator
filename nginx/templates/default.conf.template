map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

resolver 127.0.0.11 valid=10s ipv6=off;

upstream xcalificator_backend_upstream {
    zone xcalificator_backend_upstream 64k;
    server xcalificator_backend:8000 resolve;
    keepalive 16;
}


server {
    listen 80;
    server_name ${SERVER_NAME};
    server_tokens off;

    root /var/www/html;
    index index.html;

    client_max_body_size 50m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'sha256-8rEbVvLbIj2nfu8eWRg/wLDgvYT9MyBYjN3Lh2QSHjY=' 'sha256-bRN0+npVXhManCpmhgLcDwPulOk+b+c9gdWgMncQSlI=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; frame-src 'self' blob:;" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    location = /health {
        proxy_pass http://xcalificator_backend_upstream/health;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # API responses may legitimately use file-like suffixes (for example,
    # presentation preview images ending in .png). Keep the API proxy ahead
    # of the generic static-asset regex below.
    location ^~ /api/ {
        proxy_pass http://xcalificator_backend_upstream/api/;
        proxy_http_version 1.1;
        proxy_connect_timeout 30s;
        proxy_read_timeout 10m;
        proxy_send_timeout 10m;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Submission photos and generated exports are delivered only by authorized
    # API endpoints. Never expose the persistent upload volume as a directory.
    location ^~ /uploads/ {
        return 404;
    }

    location ~* \.(?:css|js|mjs|woff2?|ttf|png|jpe?g|webp|svg|ico)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'sha256-8rEbVvLbIj2nfu8eWRg/wLDgvYT9MyBYjN3Lh2QSHjY=' 'sha256-bRN0+npVXhManCpmhgLcDwPulOk+b+c9gdWgMncQSlI=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; frame-src 'self' blob:;" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'sha256-8rEbVvLbIj2nfu8eWRg/wLDgvYT9MyBYjN3Lh2QSHjY=' 'sha256-bRN0+npVXhManCpmhgLcDwPulOk+b+c9gdWgMncQSlI=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; frame-src 'self' blob:;" always;
    }
}
