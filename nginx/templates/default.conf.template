map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

server {
    listen 80;
    server_name ${SERVER_NAME};
    server_tokens off;

    root /var/www/html;
    index index.html;

    client_max_body_size 50m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:;" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    location = /health {
        proxy_pass http://xcalificator_backend:8000/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location /api/ {
        proxy_pass http://xcalificator_backend:8000/api/;
        proxy_http_version 1.1;
        proxy_connect_timeout 30s;
        proxy_read_timeout 10m;
        proxy_send_timeout 10m;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Submission photos and generated exports are delivered only by authorized
    # API endpoints. Never expose the persistent upload volume as a directory.
    location ^~ /uploads/ {
        return 404;
    }

    location = /_presenton_auth {
        internal;
        proxy_pass http://xcalificator_backend:8000/api/presentaciones/editor-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location = /api/telemetry-status {
        auth_request /_presenton_auth;
        proxy_pass http://xcalificator_presenton:80/api/telemetry-status;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Basic ${PRESENTON_BASIC_AUTH}";
    }

    location = /api/can-change-keys {
        auth_request /_presenton_auth;
        proxy_pass http://xcalificator_presenton:80/api/can-change-keys;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Basic ${PRESENTON_BASIC_AUTH}";
    }

    location ^~ /presenton/ {
        auth_request /_presenton_auth;
        proxy_pass http://xcalificator_presenton:80/;
        proxy_http_version 1.1;
        proxy_read_timeout 30m;
        proxy_connect_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Authorization "Basic ${PRESENTON_BASIC_AUTH}";
        proxy_redirect off;
    }

    location ^~ /_next/ {
        auth_request /_presenton_auth;
        proxy_pass http://xcalificator_presenton:80/_next/;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Basic ${PRESENTON_BASIC_AUTH}";
    }

    location ^~ /api/v1/ {
        auth_request /_presenton_auth;
        proxy_pass http://xcalificator_presenton:80/api/v1/;
        proxy_read_timeout 30m;
        proxy_connect_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Basic ${PRESENTON_BASIC_AUTH}";
    }

    location ^~ /app_data/ {
        auth_request /_presenton_auth;
        proxy_pass http://xcalificator_presenton:80/app_data/;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Basic ${PRESENTON_BASIC_AUTH}";
    }

    location ^~ /static/ {
        auth_request /_presenton_auth;
        proxy_pass http://xcalificator_presenton:80/static/;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Basic ${PRESENTON_BASIC_AUTH}";
    }

    location ^~ /presentation {
        auth_request /_presenton_auth;
        proxy_pass http://xcalificator_presenton:80/presentation;
        proxy_http_version 1.1;
        proxy_read_timeout 30m;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Authorization "Basic ${PRESENTON_BASIC_AUTH}";
    }

    location ~* \.(?:css|js|mjs|woff2?|ttf|png|jpe?g|webp|svg|ico)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:;" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:;" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:;" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:;" always;
    }
}
