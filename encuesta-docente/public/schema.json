    {
      "id": "practica",
      "title": "Calificación manual",
      "intro": "Piense en la última evaluación que calificó para un grupo, sin XCalificator ni otra herramienta que sugiera notas o comentarios. El tiempo excluye preparar la evaluación y registrar las notas en otra plataforma. Si hubo varias sesiones, estime su tiempo efectivo total de revisión.",
      "questions": [
        {
          "id": "manual.minutes",
          "label": "¿Cuántos minutos en total dedicó a revisar y asignar notas a esas entregas?",
          "type": "number",
          "min": 0.1,
          "max": 10080,
          "step": 0.1,
          "hint": "Escriba minutos, no horas: 1 hora y media son 90 minutos. Puede indicar decimales. Si no recuerda o no aplica, déjelo vacío. Debe ser la misma evaluación y el grupo de la pregunta sobre entregas.",
          "number": 7
        },
        {
          "id": "manual.basis",
          "label": "¿En qué se basa el tiempo que acaba de indicar?",
          "type": "radio",
          "options": [
            {
              "value": "measured",
              "label": "Cronometré o registré la hora de inicio y final"
            },
            {
              "value": "estimated",
              "label": "Lo estoy estimando de memoria"
            },
            {
              "value": "na",
              "label": "No indiqué un tiempo"
            },
            {
              "value": "skip",
              "label": "Prefiero no responder"
            }
          ],
          "number": 8
        },
        {
          "id": "manual.open_percent",
